{
  "name": "student-tracker",
  "version": "1.0.0",
  "description": "Minimal Neo-brutalist Student Tracker (MERN Stack with Mobile PWA & 24/7 Server)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/server.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "mern",
    "student-tracker",
    "neobrutalism",
    "pwa"
  ],
  "author": "Nibir Kalita",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
